+void Application::SetDanmakuEnabled(bool enabled, const std::string& mode, int loop_delay_ms) {
+    danmaku_enabled_ = enabled;
+    danmaku_mode_ = (mode == "direct") ? "direct" : "mcp";
+    if (loop_delay_ms > 0) {
+        // 限幅：太短会打断上一条朗读的收尾，太长直播间会冷场
+        if (loop_delay_ms < 300) {
+            loop_delay_ms = 300;
+        }
+        if (loop_delay_ms > 60000) {
+            loop_delay_ms = 60000;
+        }
+        danmaku_loop_delay_ms_ = loop_delay_ms;
+    }
+    if (enabled) {
+        DeviceState st = GetDeviceState();
+        if (st == kDeviceStateIdle) {
+            // 还没建立会话：先开一轮聆听，进入 Listening 后自动循环会自己接管
+            StartListening();
+        } else if (st == kDeviceStateListening) {
+            ArmDanmakuAutoTrigger();
+        }
+        // 处于 Speaking 时不用处理：这条回复说完转 Listening 时会自动挂上定时器
+    } else {
+        CancelDanmakuAutoTrigger();
+        danmaku_turn_in_flight_ = false;
+        // 退出弹幕模式：恢复正常"开麦聆听"，让用户可以继续用语音对话
+        if (GetDeviceState() == kDeviceStateListening) {
+            StartListeningAudio();
+        }
+    }
+    ESP_LOGI(TAG, "SetDanmakuEnabled: %d mode=%s loop_delay=%dms", enabled, danmaku_mode_.c_str(),
+             danmaku_loop_delay_ms_);
+}
+
+void Application::PushDanmaku(const std::string& user, const std::string& text) {
+    if (text.empty()) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(danmaku_mutex_);
+        if (danmaku_queue_.size() >= 50) {
+            danmaku_queue_.pop_front();
+        }
+        danmaku_queue_.push_back((user.empty() ? "" : ("【" + user + "】")) + text);
+    }
+    // 新弹幕到达且正处在聆听空档：确保下一轮已排上（Arm 内部幂等，不会被不断推迟）
+    if (danmaku_enabled_ && GetDeviceState() == kDeviceStateListening) {
+        ArmDanmakuAutoTrigger();
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 弹幕自动循环
+// ---------------------------------------------------------------------------
+// 用户只需说一次"开始读弹幕"，之后设备就自己转圈：
+//     朗读一条 -> 回到聆听 -> 等 danmaku_loop_delay_ms_(默认 1.5s) -> 自动触发下一条
+//     -> 朗读 -> ... 全程不需要用户再开口。
+//
+// 【为什么必须用音频，而不是直接发一段文本？】
+// 小智官方 WebSocket 协议里，设备 -> 服务端只有 hello / listen / abort / mcp 四类消息：
+//   * type:chat            —— 协议里根本不存在，服务端静默丢弃
+//                             （现象就是"没报错，但卡在聆听、什么都不发生"）
+//   * listen/state:detect  —— 只接受唤醒词，发别的文本会被拒绝：
+//                             "detect is only for wake words"
+// 也就是说，设备没有任何"发一段自由文本让 LLM 回复"的合法通道。
+// 唯一与真人说话完全等价、服务端必然接受的触发方式，是把音频交给云端 ASR。
+//
+// 所以这里把一段预置的 Opus 语音（内容"继续读弹幕"，见 danmaku_trigger_audio.h，
+// 由 固件/工具/gen_trigger_audio.py 生成）当作用户说的话推上去：
+//     listen/start(manual) -> 推送 Opus 帧 -> listen/stop
+// 云端 ASR 把它识别成一句真实的用户输入，于是 LLM 被正常触发，按控制台提示词
+// 调用 get_danmaku 取下一条弹幕朗读（没有新弹幕时按提示词自主发言）。
+//
+// 循环期间麦克风【全程关闭】：既不会把设备自己的朗读声当成用户输入形成回声环，
+// 也不会被直播间外放的声音干扰。要退出循环，按一下 BOOT 键即可。
+void Application::ArmDanmakuAutoTrigger() {
+    if (!danmaku_enabled_) {
+        return;
+    }
+    if (danmaku_timer_handle_ == nullptr) {
+        esp_timer_create_args_t danmaku_timer_args = {
+            .callback =
+                [](void* arg) {
+                    Application* app = (Application*)arg;
+                    // 定时器回调不能直接碰协议/状态，丢回主循环执行
+                    app->Schedule([app]() { app->RunDanmakuAutoTurn(); });
+                },
+            .arg = this,
+            .dispatch_method = ESP_TIMER_TASK,
+            .name = "danmaku_loop",
+            .skip_unhandled_events = true};
+        if (esp_timer_create(&danmaku_timer_args, &danmaku_timer_handle_) != ESP_OK) {
+            ESP_LOGE(TAG, "Failed to create danmaku loop timer");
+            danmaku_timer_handle_ = nullptr;
+            return;
+        }
+    }
+    if (esp_timer_is_active(danmaku_timer_handle_)) {
+        // 已经排好下一轮：直接返回，避免弹幕密集时把触发时间不断往后推
+        return;
+    }
+    esp_timer_start_once(danmaku_timer_handle_, (uint64_t)danmaku_loop_delay_ms_ * 1000);
+    ESP_LOGI(TAG, "Danmaku auto trigger armed (+%d ms)", danmaku_loop_delay_ms_);
+}
+
+void Application::CancelDanmakuAutoTrigger() {
+    if (danmaku_timer_handle_ != nullptr) {
+        esp_timer_stop(danmaku_timer_handle_);
+    }
+}
+
+void Application::RunDanmakuAutoTurn() {
+    if (!danmaku_enabled_) {
+        return;
+    }
+    if (GetDeviceState() != kDeviceStateListening) {
+        return;
+    }
+    if (protocol_ == nullptr || !protocol_->IsAudioChannelOpened()) {
+        ESP_LOGW(TAG, "Danmaku auto turn skipped: audio channel closed");
+        return;
+    }
+    if (danmaku_turn_in_flight_) {
+        return;
+    }
+    danmaku_turn_in_flight_ = true;
+
+    // 用 manual 模式显式框定这一轮语音：推完立刻 stop，云端马上做 ASR，
+    // 不必等 VAD 判静音，触发更快也更确定。
+    // 注意只让协议消息用 manual，不改 listening_mode_ —— 否则 tts/stop 时
+    // 会按 manual 规则转 Idle，循环就断了。
+    protocol_->SendStartListening(kListeningModeManualStop);
+    bool ok = SendDanmakuTriggerAudio();
+    protocol_->SendStopListening();
+    danmaku_turn_in_flight_ = false;
+
+    ESP_LOGI(TAG, "Danmaku auto turn fired, trigger audio %s", ok ? "sent" : "FAILED");
+    if (!ok) {
+        // 发送失败（网络抖动等）：重排一轮，别让循环彻底停摆
+        ArmDanmakuAutoTrigger();
+    }
+}
+
+bool Application::SendDanmakuTriggerAudio() {
+    size_t offset = 0;
+    for (size_t i = 0; i < DANMAKU_TRIGGER_FRAME_COUNT; i++) {
+        uint16_t len = kDanmakuTriggerFrameSizes[i];
+        if (offset + len > sizeof(kDanmakuTriggerOpus)) {
+            ESP_LOGE(TAG, "Danmaku trigger audio table corrupted");
+            return false;
+        }
+        auto packet = std::make_unique<AudioStreamPacket>();
+        packet->sample_rate = DANMAKU_TRIGGER_SAMPLE_RATE;
+        packet->frame_duration = DANMAKU_TRIGGER_FRAME_DURATION;
+        packet->timestamp = 0;
+        packet->payload.assign(kDanmakuTriggerOpus + offset, kDanmakuTriggerOpus + offset + len);
+        offset += len;
+        if (!protocol_->SendAudio(std::move(packet))) {
+            ESP_LOGW(TAG, "SendAudio failed at trigger frame %d", (int)i);
+            return false;
+        }
+    }
+    return true;
+}
