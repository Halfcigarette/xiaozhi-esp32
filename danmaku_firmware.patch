+#ifndef DANMAKU_MCP_TOOL_H
+#define DANMAKU_MCP_TOOL_H
+
+#include "mcp_server.h"
+#include "settings.h"
+
+// 弹幕朗读 MCP 工具：让小智通过一句语音指令进入/退出"弹幕自动循环"。
+// 开启后设备自己转圈（读一条 -> 等 delay_ms -> 自动读下一条），不需要用户再介入；
+// 退出方式：语音让小智关闭，或直接按一下 BOOT 键。
+// mode: "mcp"(默认) = 弹幕内容由云端 LLM 经 get_danmaku 取回（免设备 IP，推荐）；
+//       "direct"     = 设备经 TCP(:12345) 收到 PC 转发器推来的原始弹幕。
+class DanmakuMcpTool {
+public:
+    DanmakuMcpTool();
+    void Initialize();
+    bool IsDanmakuEnabled() const;
+    const std::string& GetDanmakuMode() const { return danmaku_mode_; }
+
+private:
+    bool danmaku_enabled_ = false;
+    std::string danmaku_mode_ = "mcp";
+    int danmaku_delay_ms_ = 1500;
+    void SetDanmakuEnabled(bool enabled, const std::string& mode = "mcp", int delay_ms = 0);
+    ReturnValue HandleSetDanmakuEnabled(const PropertyList& properties);
+};
+
+#endif // DANMAKU_MCP_TOOL_H
