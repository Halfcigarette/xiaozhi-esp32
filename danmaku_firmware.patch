+#include "danmaku_tcp_server.h"
+#include <cstring>
+#include <string>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <unistd.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <cJSON.h>
+#include <esp_log.h>
+#include "application.h"
+
+static const char* TAG = "DanmakuTCP";
+
+static void danmaku_server_task(void* arg) {
+    int port = (int)(intptr_t)arg;
+    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (server_fd < 0) {
+        ESP_LOGE(TAG, "socket() failed");
+        return;
+    }
+    int opt = 1;
+    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
+
+    struct sockaddr_in addr {};
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = INADDR_ANY;
+    addr.sin_port = htons((uint16_t)port);
+    if (bind(server_fd, (struct sockaddr*)&addr, sizeof(addr)) != 0) {
+        ESP_LOGE(TAG, "bind() to port %d failed", port);
+        close(server_fd);
+        return;
+    }
+    listen(server_fd, 1);
+    ESP_LOGI(TAG, "danmaku tcp server listening on port %d", port);
+
+    while (true) {
+        int client_fd = accept(server_fd, nullptr, nullptr);
+        if (client_fd < 0) {
+            continue;
+        }
+        ESP_LOGI(TAG, "client connected");
+        char buf[512];
+        std::string line;
+        ssize_t n;
+        while ((n = read(client_fd, buf, sizeof(buf) - 1)) > 0) {
+            buf[n] = 0;
+            line += buf;
+            size_t lf;
+            while ((lf = line.find('\n')) != std::string::npos) {
+                std::string msg = line.substr(0, lf);
+                line.erase(0, lf + 1);
+                cJSON* root = cJSON_Parse(msg.c_str());
+                if (!root) {
+                    continue;
+                }
+                cJSON* cmd = cJSON_GetObjectItem(root, "cmd");
+                if (cmd && cJSON_IsString(cmd)) {
+                    if (strcmp(cmd->valuestring, "danmaku") == 0) {
+                        cJSON* user = cJSON_GetObjectItem(root, "user");
+                        cJSON* text = cJSON_GetObjectItem(root, "text");
+                        if (text && cJSON_IsString(text)) {
+                            std::string u = (user && cJSON_IsString(user)) ? user->valuestring : "";
+                            Application::GetInstance().PushDanmaku(u, text->valuestring);
+                        }
+                    } else if (strcmp(cmd->valuestring, "enable") == 0) {
+                        cJSON* value = cJSON_GetObjectItem(root, "value");
+                        if (value) {
+                            Application::GetInstance().SetDanmakuEnabled(value->valueint != 0);
+                        }
+                    }
+                }
+                cJSON_Delete(root);
+            }
+        }
+        close(client_fd);
+        ESP_LOGI(TAG, "client disconnected");
+    }
+}
+
+void danmaku::StartDanmakuServer(int port) {
+    xTaskCreate(danmaku_server_task, "danmaku_tcp", 8192, (void*)(intptr_t)port, 5, nullptr);
+}
