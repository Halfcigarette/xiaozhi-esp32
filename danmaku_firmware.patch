+#pragma once
+
+namespace danmaku {
+
+// 设备端 TCP 服务：监听 port，接收 PC 转发器发来的弹幕与开关指令。
+// 协议（每行一条 JSON，以 \n 分隔）：
+//   {"cmd":"danmaku","user":"昵称","text":"内容"}  -> 入队并触发朗读
+//   {"cmd":"enable","value":true|false}            -> 开关弹幕朗读
+void StartDanmakuServer(int port = 12345);
+
+} // namespace danmaku
