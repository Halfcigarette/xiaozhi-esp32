new file mode 100644
index 0000000..8b203a9
--- /dev/null
+++ b/main/boards/common/danmaku_mcp_tool.cc
@@ -0,0 +1,72 @@
+#include "danmaku_mcp_tool.h"
+#include <esp_log.h>
+#include "application.h"
+#include "settings.h"
+#include "danmaku_tcp_server.h"
+
+static const char* TAG = "DanmakuMcpTool";
+
+DanmakuMcpTool::DanmakuMcpTool() : danmaku_enabled_(false) {
+}
+
+void DanmakuMcpTool::Initialize() {
+    Settings settings("vendor");
+    danmaku_enabled_ = settings.GetInt("danmaku_enabled", 0) != 0;
+    std::string mode = settings.GetString("danmaku_mode", "mcp");
+    danmaku_mode_ = (mode == "direct") ? "direct" : "mcp";
+
+    auto& mcp_server = McpServer::GetInstance();
+    mcp_server.AddTool("self.set_danmaku_enabled",
+        "开启或关闭朗读直播间弹幕。开启后，小智会按 mode 逐条朗读并对话式回复弹幕；关闭后恢复正常语音模式。\n"
+        "参数 enabled 为 true 时开始读取弹幕，为 false 时停止。\n"
+        "参数 mode(可选，默认 mcp)：\n"
+        "  - \"mcp\"   : 设备只发送读取提示(nudge)，弹幕内容由云端 LLM 调用 get_danmaku 取回，"
+        "无需知道设备 IP，最适合跨网络/动态 IP 场景（推荐）。\n"
+        "  - \"direct\": 设备经局域网 TCP(:12345) 收到 PC 转发器推送的原始弹幕并直接注入，"
+        "延迟最低，但要求 PC 与设备同局域网且知道设备 IP。",
+        PropertyList({
+            Property("enabled", kPropertyTypeBoolean),
+            Property("mode", kPropertyTypeString, std::string("mcp"))
+        }),
+        [this](const PropertyList& properties) -> ReturnValue {
+            return HandleSetDanmakuEnabled(properties);
+        });
+
+    ESP_LOGI(TAG, "DanmakuMcpTool initialized, enabled=%d mode=%s", danmaku_enabled_, danmaku_mode_.c_str());
+}
+
+bool DanmakuMcpTool::IsDanmakuEnabled() const {
+    return danmaku_enabled_;
+}
+
+ReturnValue DanmakuMcpTool::HandleSetDanmakuEnabled(const PropertyList& properties) {
+    bool enabled = properties["enabled"].value<bool>();
+    std::string mode = "mcp";
+    try {
+        mode = properties["mode"].value<std::string>();
+    } catch (...) {
+        mode = "mcp";
+    }
+    SetDanmakuEnabled(enabled, mode);
+    return true;
+}
+
+void DanmakuMcpTool::SetDanmakuEnabled(bool enabled, const std::string& mode) {
+    danmaku_enabled_ = enabled;
+    danmaku_mode_ = (mode == "direct") ? "direct" : "mcp";
+    Settings settings("vendor", true);
+    settings.SetInt("danmaku_enabled", enabled ? 1 : 0);
+    settings.SetString("danmaku_mode", danmaku_mode_);
+    Application::GetInstance().SetDanmakuEnabled(enabled, danmaku_mode_);
+
+    // 懒启动设备端 TCP 服务（仅 direct 模式需要）：
+    // 不在开机时启动，因为此时 LWIP tcpip 线程尚未就绪，socket() 会触发 Invalid mbox 断言崩溃；
+    // 此处由语音指令"读取弹幕"触发，彼时设备已连上 xiaozhi 云，网络栈必然已就绪。
+    static bool server_started = false;
+    if (enabled && danmaku_mode_ == "direct" && !server_started) {
+        danmaku::StartDanmakuServer(12345);
+        server_started = true;
+        ESP_LOGI(TAG, "Danmaku TCP server started on :12345 (direct mode)");
+    }
+    ESP_LOGI(TAG, "Danmaku enabled: %d mode: %s", enabled, danmaku_mode_.c_str());
+}
