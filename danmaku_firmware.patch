+void Application::SetDanmakuEnabled(bool enabled, const std::string& mode) {
+    danmaku_enabled_ = enabled;
+    danmaku_mode_ = (mode == "direct") ? "direct" : "mcp";
+    if (enabled) {
+        DeviceState st = GetDeviceState();
+        if (st == kDeviceStateIdle) {
+            StartListening();
+        } else if (st == kDeviceStateListening) {
+            Schedule([this]() { InjectNextDanmaku(); });
+        }
+    } else {
+        if (GetDeviceState() == kDeviceStateListening) {
+            StopListening();
+        }
+    }
+    ESP_LOGI(TAG, "SetDanmakuEnabled: %d mode=%s", enabled, danmaku_mode_.c_str());
+}
+
+void Application::PushDanmaku(const std::string& user, const std::string& text) {
+    if (text.empty()) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(danmaku_mutex_);
+        if (danmaku_queue_.size() >= 50) {
+            danmaku_queue_.pop_front();
+        }
+        danmaku_queue_.push_back((user.empty() ? "" : ("【" + user + "】")) + text);
+    }
+    if (danmaku_enabled_ && GetDeviceState() == kDeviceStateListening) {
+        Schedule([this]() { InjectNextDanmaku(); });
+    }
+}
+
+// 云 MCP 模式下，设备不直接持有弹幕文本，只发一句"读取提示"(nudge)，
+// 由云端 LLM 调用 get_danmaku 取回最新弹幕并朗读+回复。无需设备 IP，跨网络可用。
+// 注意：nudge 必须尽量短——它经 listen/detect 发给云端，过长可能触发
+// 云端 "detect is only for wake words, do not send long texts" 的拦截。
+static const char* kDanmakuNudgeText =
+    "【读取弹幕】调用get_danmaku读取最新一条弹幕，原样朗读后回复。";
+
+// 直连(direct)模式下原始弹幕经 listen/detect 直发云端，云端对 detect 文本有长度限制，
+// 超过会被拒并报 "detect is only for wake words, do not send long texts"。
+// 固件侧按 UTF-8 字符数截断（超长加"…"），避免报错；
+// 若需原样朗读长弹幕，请改用 MCP 模式（默认，由云端 get_danmaku 取回，无长度限制）。
+static const size_t kDanmakuMaxInjectChars = 60;
+
+// 按 UTF-8 字符（而非字节）截断，避免截断在多字节字符中间导致乱码。
+static std::string TruncateUtf8(const std::string& s, size_t max_chars) {
+    size_t i = 0, chars = 0;
+    while (i < s.size() && chars < max_chars) {
+        unsigned char c = static_cast<unsigned char>(s[i]);
+        int len = (c < 0x80) ? 1 : (c < 0xE0) ? 2 : (c < 0xF0) ? 3 : 4;
+        i += len;
+        chars++;
+    }
+    return s.substr(0, i);
+}
+
+void Application::InjectNextDanmaku() {
+    if (!danmaku_enabled_) {
+        return;
+    }
+    if (danmaku_mode_ == "direct") {
+        // 直连模式：取设备经 TCP(:12345) 收到的原始弹幕，当作用户输入注入
+        std::string text;
+        {
+            std::lock_guard<std::mutex> lock(danmaku_mutex_);
+            if (danmaku_queue_.empty()) {
+                return;
+            }
+            text = danmaku_queue_.front();
+            danmaku_queue_.pop_front();
+        }
+        // 直连模式把原始弹幕直发云端，云端对 detect 文本有长度限制，超长会被拒；
+        // 固件侧按字符数截断（超出加"…"），避免报 "detect is only for wake words"。
+        std::string injected = TruncateUtf8(text, kDanmakuMaxInjectChars);
+        if (injected.size() < text.size()) {
+            injected += "…";
+        }
+        if (protocol_) {
+            protocol_->SendUserText(injected);
+            ESP_LOGI("Danmaku", "inject(direct): %s", injected.c_str());
+        }
+        return;
+    }
+    // 云 MCP 模式（默认）：发送 nudge，由 LLM 经 get_danmaku 拉取弹幕
+    if (protocol_) {
+        protocol_->SendUserText(kDanmakuNudgeText);
+        ESP_LOGI("Danmaku", "inject(mcp nudge)");
+    }
+}
